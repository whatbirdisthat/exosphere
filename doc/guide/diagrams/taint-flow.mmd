%% T1 dataflow/taint: catching a payload split across lines (and files) that single-line regex misses.
%% Source: src/core/matchers/shell-dataflow.ts, shell-crossfile-dataflow.ts, ADR-006/007
flowchart TD
    subgraph SRC["Tainted SOURCEs (where untrusted data enters)"]
        s1["command substitution $(...)"]
        s2["network fetch — curl / wget"]
        s3["base64 / hex decode"]
        s4["sensitive env var · read from stdin"]
    end

    P["Propagate taint across lines<br/>(single forward pass, top → bottom)<br/>assignment whose RHS uses a tainted var → tainted"]

    subgraph XF["Cross-file (ADR-007)"]
        x1["resolve 'source ./lib.sh' in-memory<br/>(path-safe, never fetches/executes)<br/>import tainted vars from the sibling"]
    end

    subgraph SINK["Dangerous SINKs (where tainted data becomes dangerous)"]
        k1["pipe to sh / bash / zsh"]
        k2["eval · exec"]
        k3["source / . a tainted target"]
        k4["write to an autorun location<br/>(.bashrc · crontab · systemd · authorized_keys)"]
    end

    s1 & s2 & s3 & s4 --> P
    x1 --> P
    P --> SINK
    SINK --> F["Finding at the SINK's file:line<br/>tier T1 · OWASP ASI04 · MITRE ATLAS"]

    note["Example a regex misses:<br/>URL=$(get_secret); P=$(curl &quot;$URL&quot;); echo &quot;$P&quot; | sh"]
    P -.- note
