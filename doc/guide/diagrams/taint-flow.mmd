%% T1 dataflow/taint: catching a payload split across lines (and files) that single-line regex misses.
%% Colour key: amber = untrusted input · blue = the analysis · purple = cross-file · red = danger.
%% 2x2 source/sink grids keep the figure narrow so the text stays legible at page width.
%% Source: src/core/matchers/shell-dataflow.ts, shell-crossfile-dataflow.ts, ADR-006/007
flowchart TD
    subgraph SRC["Tainted SOURCEs — untrusted data enters"]
        direction LR
        s1["command substitution<br/>$(...)"]:::warn ~~~ s2["network fetch<br/>curl / wget"]:::warn
        s3["base64 / hex decode"]:::warn ~~~ s4["sensitive env var · stdin"]:::warn
    end

    XF["Cross-file (ADR-007)<br/>resolve 'source ./lib.sh' in-memory<br/>path-safe · never fetches/executes"]:::accent
    P["Propagate taint across lines<br/>assignment whose RHS uses a tainted var → tainted<br/>(single forward pass, top → bottom)"]:::core

    subgraph SINK["Dangerous SINKs — tainted data becomes dangerous"]
        direction LR
        k1["pipe to sh / bash / zsh"]:::danger ~~~ k2["eval · exec"]:::danger
        k3["source a tainted target"]:::danger ~~~ k4["write to autorun<br/>.bashrc · crontab · systemd"]:::danger
    end

    SRC --> P
    XF --> P
    P --> SINK
    SINK --> F["Finding at the SINK's file:line<br/>tier T1 · OWASP ASI04 · MITRE ATLAS"]:::danger

    classDef warn fill:#fbe7c0,stroke:#bf8700,color:#16212e;
    classDef core fill:#dbe7f5,stroke:#3f6fae,color:#16212e;
    classDef accent fill:#e6dcf7,stroke:#8250df,color:#16212e;
    classDef danger fill:#ffd7d2,stroke:#cf222e,color:#16212e;
    style SRC fill:#fbf0d8,stroke:#bf8700,color:#16212e;
    style SINK fill:#ffe6e2,stroke:#cf222e,color:#16212e;
