%% The detection tiers. Everything default-on stays deterministic + offline + never-executing.
%% Colour key: blue = pattern · teal = dataflow · purple = temporal · grey/dashed = reserved, unbuilt.
%% Source: src/core/types.ts (RuleTier), ADR-004/006/007/008
flowchart LR
    subgraph DEFAULT["Default-on — deterministic · offline · never-executes"]
        direction LR
        T0["<b>T0 · Pattern</b><br/>per-file regex +<br/>vetted structural matchers<br/>curl·sh · unicode · MCP scopes"]:::core
        T1["<b>T1 · Dataflow / taint</b><br/>multi-line shell<br/>SOURCE → propagate → SINK<br/>intra- + cross-file"]:::io
        T3["<b>T3 · Temporal / rug-pull</b><br/>diff vs approved lockfile<br/>not a rule (two inputs)<br/>additive-only"]:::accent
        T0 --> T1 --> T3
    end

    T2["<b>T2 · Semantic</b> — claims-vs-behaviour<br/>would need an LLM → breaks offline + determinism<br/><i>not built; reserved as a future opt-in tier</i>"]:::off
    T3 -.->|"future, opt-in only"| T2

    classDef core fill:#dbe7f5,stroke:#3f6fae,color:#16212e;
    classDef io fill:#d2ebe8,stroke:#2a9d8f,color:#16212e;
    classDef accent fill:#e6dcf7,stroke:#8250df,color:#16212e;
    classDef off fill:#f1f1f1,stroke:#9aa3ad,color:#6a727c,stroke-dasharray:5 4;
    style DEFAULT fill:#e7f3ea,stroke:#2da44e,color:#16212e;
