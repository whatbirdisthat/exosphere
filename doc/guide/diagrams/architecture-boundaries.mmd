%% The never-execute guarantee is STRUCTURAL: only the adapter layer touches the outside world.
%% The pure core imports node:* nothing — enforced by a layering test (ADR-001).
%% Source: ADR-001, src/core/*, src/adapters/*, src/core/__tests__/layering.test.ts
flowchart TD
    subgraph CLI["CLI layer — orchestration"]
        cli["cli.ts / bin.ts<br/>parse args · wire stages · format · exit code"]
    end

    subgraph ADAPTERS["Adapter layer — the ONLY code that does I/O"]
        acq["acquire.ts<br/>git clone (read-only) · temp dirs"]
        enum["enumerate.ts<br/>walk filesystem · read files"]
        lock["lockfile.ts<br/>read/write .skillsentry.lock · sha256"]
    end

    subgraph CORE["Pure core — imports node:* NOTHING (no fs, child_process, crypto, net)"]
        engine["engine.ts · ruleset.ts · compile.ts"]
        rules["rules/*.rules.ts (data) · matchers/* (vetted fns)"]
        logic["verdict.ts · drift.ts · lock.ts · report.ts · ignore.ts"]
    end

    cli --> acq & enum & lock
    acq -->|"FileRecord[] (in memory)"| engine
    enum -->|"FileRecord[]"| engine
    lock -->|"parsed LockFile"| logic
    engine --> rules
    engine --> logic
    logic -->|"AuditReport (pure data)"| cli

    note["Audited content is DATA, never code:<br/>no eval · no shell · no dynamic import.<br/>A hostile target cannot run."]
    CORE -.- note
